# =========================================
# VibeTogether — root environment template
# Copy to .env (and to web/.env.local + api/.env) and fill in values.
# =========================================

# ---- Shared ----
NODE_ENV=development

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- API (Express) ----
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# ---- Database ----
# Local dev via docker-compose: docker compose up -d
DATABASE_URL=postgresql://vibe:vibe@localhost:5432/vibetogether?schema=public

# ---- Redis (sockets pub/sub + room state) ----
REDIS_URL=redis://localhost:6379

# ---- JWT ----
JWT_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Google OAuth ----
# https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URI: http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# ---- Spotify OAuth ----
# https://developer.spotify.com/dashboard → Create app
# Redirect URI: http://localhost:4000/auth/spotify/callback
# Required scopes: streaming, user-read-email, user-read-private,
#   user-read-playback-state, user-modify-playback-state,
#   user-read-currently-playing, playlist-read-private,
#   user-read-recently-played, user-top-read
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:4000/auth/spotify/callback
